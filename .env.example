# Google OAuth Client IDs
# Create these at https://console.cloud.google.com/apis/credentials
# Android: Application type = Android, use your package name + SHA-1
# iOS: Application type = iOS, use your bundle identifier
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Enable dev fixtures (mock Drive data for development without credentials)
# Set to "true" to use fixtures, remove or set "false" for production
EXPO_PUBLIC_USE_DEV_FIXTURES=true

# Upload folder name in Google Drive (default: "Drive Photos Uploads")
EXPO_PUBLIC_UPLOAD_FOLDER_NAME=Drive Photos Uploads
